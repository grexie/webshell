WEBSHELL_HOST=0.0.0.0
WEBSHELL_PORT=8080
WEBSHELL_AUTHORIZED_KEYS=
WEBSHELL_AUTHORIZED_KEYS_INLINE=
WEBSHELL_AUTH_CHALLENGE_TTL=5m
WEBSHELL_AUTH_SESSION_TTL=12h
WEBSHELL_STATIC_DIR=
WEBSHELL_RUNTIME_DIR=/tmp
WEBSHELL_USER=tim
WEBSHELL_UID=1000
WEBSHELL_GID=1000
WEBSHELL_USER_PASSWORD=
WEBSHELL_USER_SHELL=/bin/bash
WEBSHELL_USER_SUDO=true
WEBSHELL_USER_SUDO_NOPASSWD=true
WEBSHELL_HOME=/home/tim
WEBSHELL_GUI_ENABLED=false
WEBSHELL_GUI_DEFAULT=gnome
WEBSHELL_GUI_COMMAND=webshell-gui-session
WEBSHELL_GUI_XSERVER=auto
WEBSHELL_GUI_WIDTH=1280
WEBSHELL_GUI_HEIGHT=720
WEBSHELL_GUI_DEPTH=24
WEBSHELL_GUI_FPS=20
WEBSHELL_GUI_QUALITY=50
WEBSHELL_AUDIO_ENABLED=true
WEBSHELL_AUDIO_SAMPLE_RATE=48000
WEBSHELL_AUDIO_CHANNELS=2
WEBSHELL_AUDIO_CODEC=pcm-s16le
WEBSHELL_AUDIO_BITRATE=96000
WEBSHELL_AUDIO_LATENCY_MS=80
WEBSHELL_E2EE_ENABLED=true
WEBSHELL_E2EE_REQUIRED=true
WEBSHELL_COMPRESSION_ENABLED=false
WEBSHELL_COMPRESSION_CODEC=gzip
WEBSHELL_COMPRESSION_MIN_BYTES=256
WEBSHELL_GUI_MIN_WIDTH=640
WEBSHELL_GUI_MIN_HEIGHT=480
WEBSHELL_GUI_MAX_WIDTH=2560
WEBSHELL_GUI_MAX_HEIGHT=1600
WEBSHELL_DEBUG_KEYS=false
WEBSHELL_INSTALL_CHROME=true
WEBSHELL_INSTALL_VSCODE=true
WEBSHELL_INSTALL_TELEGRAM=true
WEBSHELL_INSTALL_CODEX=true
WEBSHELL_INSTALL_CHATGPT=true
NODE_ENV=development
